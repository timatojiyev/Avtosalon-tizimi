# Nusxa oling:  cp .env.example .env   va parollarni almashtiring.
# .env faylini git'ga qo'shmang!
TAG=latest
GATEWAY_PORT=8080
WEB_PORT=8080
LOG_LEVEL=INFO
SEED_DEMO_DATA=1

CAR_DB_USER=car_user
CAR_DB_PASSWORD=change_me_car
CUSTOMER_DB_USER=customer_user
CUSTOMER_DB_PASSWORD=change_me_customer
SALES_DB_USER=sales_user
SALES_DB_PASSWORD=change_me_sales
FINANCING_DB_USER=financing_user
FINANCING_DB_PASSWORD=change_me_financing

# Web panel (BFF): sessiya kaliti va foydalanuvchi parollari.
# Production'da (APP_ENV=production) parol berilmagan foydalanuvchi o'chiq bo'ladi, SECRET_KEY majburiy.
SECRET_KEY=change_me_long_random_string
# Tashqi API (/api/*) kaliti — so'rovlarda X-API-Key sarlavhasi
GATEWAY_API_KEY=change_me_api_key
WEB_ADMIN_PASSWORD=
WEB_MENEJER_PASSWORD=
WEB_KREDIT_PASSWORD=
# AUDIT_LOG_PATH=/tmp/audit.jsonl

# CI/CD (serverda deploy.sh avtomatik o'rnatadi)
APP_ENV=development
REGISTRY=avtosalon
# REGISTRY=ghcr.io/<github-username>/avtosalon
